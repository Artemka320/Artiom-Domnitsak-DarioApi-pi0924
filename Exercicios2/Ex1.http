{
  "name": "2 Ex1",
  "port": 4563,
  "protocol": "http",
  "stubs": [

    {
      "predicates": [
        {
          "equals": {
            "method": "POST",
            "path": "/api/alunos"
          }
        },
        {
          "matches": {
            "body": "\"idade\"\\s*:\\s*[0-9](\\D|$)"
          }
        }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 400,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "error": "Idade mínima não atingida"
            }
          }
        }
      ]
    },

    {
      "predicates": [
        {
          "equals": {
            "method": "POST",
            "path": "/api/alunos"
          }
        },
        {
          "not": {
            "matches": {
              "body": "\"curso\"\\s*:\\s*\"TPSI\""
            }
          }
        }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 404,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "error": "Curso não encontrado"
            }
          }
        }
      ]
    },

    {
