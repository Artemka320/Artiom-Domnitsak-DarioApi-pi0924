POST http://localhost:2525/imposters
Content-Type: application/json

{
  "name": "2 Ex5",
  "port": 4567,
  "protocol": "http",
  "stubs": [

    {
      "predicates": [
        {
          "equals": {
            "method": "GET",
            "path": "/api/funcionarios"
          }
        }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 200,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": [
              {
                "id": 1,
                "nome": "Ana Silva",
                "cargo": "Programadora",
                "salario": 1200
              },
              {
                "id": 2,
                "nome": "João Costa",
                "cargo": "Analista",
                "salario": 950
              }
            ]
          }
        }
      ]
    },

    {
      "predicates": [
        {
          "equals": {
            "method": "POST",
            "path": "/api/funcionarios"
          }
        },
        {
          "matches": {
            "body": "\"salario\"\\s*:\\s*(\\d{1,3}|7[0-5][0-9])"
          }
        }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 400,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "error": "Salário inferior ao mínimo (760€)"
            }
          }
        }
      ]
    },

    {
      "predicates": [
        {
          "equals": {
            "method": "POST",
            "path": "/api/funcionarios"
          }
        }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 201,
            "headers": {
              "Content-Type": "application/json",
              "Location": "/api/funcionarios/3"
            },
            "body": {
              "id": 3,
              "status": "criado"
            }
          }
        }
      ]
    },

    {
