          }
        },
        {
          "matches": {
            "body": "\"salario\"\\s*:\\s*(0|[1-7][0-5][0-9])"
          }
        }
      ],
      "responses": [
        {
          "is": {
            "statusCode": 400,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "error": "Salário não pode ser inferior ao mínimo"
            }
          }
        }
      ]
    },

    {
      "predicates": [
        {
          "equals": {
            "method": "PUT",
            "path": "/api/funcionarios/1/salario"
          }
        }
      ],
      "responses": [
        {
          "is": {
